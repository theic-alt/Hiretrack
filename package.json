{
  "name": "hiretrack",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node -e \"if (!require('fs').existsSync('./client/dist')) require('child_process').execSync('npm run build', {stdio: 'inherit'});\" && node server/index.js",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "server": "npm --prefix server run start",
    "server:dev": "npm --prefix server run dev",
    "db:setup": "npm --prefix server run db:setup",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.23.0"
  }
}
