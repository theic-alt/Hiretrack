{
  "name": "hiretrack",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run server:dev\" \"npm run client\"",
    "server": "npm --prefix server run start",
    "server:dev": "npm --prefix server run dev",
    "db:setup": "npm --prefix server run db:setup",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "multer": "^2.4.0"
  }
}
